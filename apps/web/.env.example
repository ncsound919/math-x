# ── Auth ────────────────────────────────────────────────────────────────────
# Must match one of the keys in API_KEYS in apps/api/.env.
# Used by apiFetch() to authenticate all /api/* requests.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VITE_API_KEY=your_api_key_here

# ── API URL ─────────────────────────────────────────────────────────────────
# In development this is handled by Vite's proxy (vite.config.ts → /api → localhost:5000).
# In production Docker builds, pass as --build-arg VITE_API_URL=https://your-api.example.com
# VITE_API_URL=http://localhost:5000
